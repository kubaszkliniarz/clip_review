# Local development credentials. Copy to `.env` and fill in real values.
# `.env` is gitignored — never commit it. CI sets these as repo secrets,
# not via this file.
#
# Get a Twitch app at https://dev.twitch.tv/console/apps. Any redirect URL
# works for the app-credentials grant we use; the redirect isn't actually
# called.

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
